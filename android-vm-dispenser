 if not isinstance(guest,str) or not os.path.isabs(guest) or '\0' in guest or guest.endswith('/'): raise ValueError('guest_path must be an absolute file path')
 if type(executable) is not bool: raise ValueError('executable must be boolean')
 with open(local,'rb') as src:
  h=hashlib.sha256(); size=0
  for block in iter(lambda: src.read(1048576),b''): h.update(block); size+=len(block)
