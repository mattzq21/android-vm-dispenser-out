 def read_input():
  try:
   buffered=bytearray()
   while True:
    chunk=os.read(sys.stdin.fileno(),65536)
    if not chunk: break
    buffered.extend(chunk)
    while b'\n' in buffered:
     line,_,rest=buffered.partition(b'\n'); buffered=bytearray(rest); incoming.put(bytes(line))
  finally: cancelled.set(); incoming.put(None)
 threading.Thread(target=read_input,daemon=True).start()
 with lease(cancel=cancelled,owner_token=os.environ.get('ANDROID_VM_DISPENSER_OWNER_TOKEN')) as (c,port,control), InteractionSession(c,port,cancelled) as interaction:
  def watch():
   try: control.recv(1)
   except OSError: pass
   cancelled.set(); incoming.put(None)
  threading.Thread(target=watch,daemon=True).start()
  while not cancelled.is_set():
   line=incoming.get()
   if line is None: break
   try: req=json.loads(line)
   except ValueError:
    emit({'jsonrpc':'2.0','id':None,'error':{'code':-32700,'message':'Parse error'}}); continue
   if not isinstance(req,dict) or req.get('jsonrpc')!='2.0' or not isinstance(req.get('method'),str):
    emit({'jsonrpc':'2.0','id':None,'error':{'code':-32600,'message':'Invalid request'}}); continue
   if 'id' not in req: continue
   response={'jsonrpc':'2.0','id':req['id']}
   control.sendall(b'B')
   try:
    method=req['method']; params=req.get('params',{})
    if not isinstance(params,dict): raise ValueError('params must be an object')
    if method=='initialize':
     version=params.get('protocolVersion')
     response['result']={'protocolVersion':version if version in ('2024-11-05','2025-03-26','2025-06-18') else '2024-11-05','capabilities':{'tools':{}},'serverInfo':{'name':'android-vm-dispenser','version':'1.0.0'}}
    elif method=='ping': response['result']={}
    elif method=='tools/list': response['result']={'tools':TOOLS}
    elif method=='tools/call':
     name=params.get('name'); args=params.get('arguments',{})
     if not isinstance(args,dict): raise ValueError('arguments must be an object')
     if name not in {t['name'] for t in TOOLS}: raise ValueError('unknown tool')
     try:
      if name=='screenshot':
       body=screenshot(c,port,cancelled)
      else:
       if name=='upload': result=upload(c,port,args,cancel=cancelled)
       elif name in ('install_app','run_app'): result=cli_app(c,port,name,args,cancelled)
       elif name=='ui_hierarchy': result=layout(c,port,cancelled)
       elif name in UI_TOOLS: result=interaction.call(name,args)
       else:
        if name=='tap':
         if any(type(args.get(k)) is not int or args[k]<0 for k in ('x','y')): raise ValueError('x and y must be nonnegative integers')
         args={'argv':['input','tap',str(args['x']),str(args['y'])]}
        elif name=='keyevent':
         key=args.get('key')
         if not isinstance(key,str) or not re.fullmatch(r'(KEYCODE_[A-Z0-9_]+|[0-9]+)',key): raise ValueError('invalid Android key code')
         args={'argv':['input','keyevent',key]}
        result=execute(c,port,args,cancel=cancelled)
       body={'content':[{'type':'text','text':json.dumps(result)}],'isError':bool(result.get('exit_code',0))}
     except Exception as e: body={'content':[{'type':'text','text':str(e)}],'isError':True}
     response['result']=body
    else: response['error']={'code':-32601,'message':'Method not found'}
   except ValueError as e: response['error']={'code':-32602,'message':str(e)}
   finally:
    with contextlib.suppress(OSError): control.sendall(b'I')
   emit(response)


def auto_view(key,c):
 if not c['auto_view']: return
 try: launch_viewer(key)
 except Exception as e: log('Host viewer could not open: '+str(e)+'.')

def keep_viewer(key,stopped,cancel=None):
 last_error=None
 while not stopped.wait(3):
  if cancel is not None and cancel.is_set(): return
  record=STATE/'instances'/key/'record.json'
  try:
   r=json.loads(record.read_text())
   if r.get('id')!=key or not alive(r): return
   launch_viewer(key)
   last_error=None
  except FileNotFoundError:
   if not record.exists(): return
  except Exception as e:
   error=str(e)
   if error!=last_error: log('Host viewer recovery failed: '+error+'.')
   last_error=error

def viewer_windows(runtime):
 # Only this dispenser state's recorded, still-running viewer processes count.
 owned={}
 for marker in runtime.glob('*.viewer.json'):
  try:
   saved=json.loads(marker.read_text())
