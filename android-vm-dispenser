def execute(c,port,args,cancel=None):
 argv=args.get('argv'); timeout=args.get('timeout_sec',60)
 if not isinstance(argv,list) or not argv or not all(isinstance(a,str) and '\0' not in a for a in argv) or not argv[0]: raise ValueError('argv must be a nonempty array of strings')
 if type(timeout) is not int or not 1<=timeout<=300: raise ValueError('timeout_sec must be 1..300')
 # Guest toybox timeout ensures the remote command stops even when ADB disconnects.
 result=bounded(adb(c,port)+[shlex.join(['timeout','-k','2',str(timeout)]+argv)],timeout+8,cancel=cancel)
