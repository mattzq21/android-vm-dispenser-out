def setup():
 os.umask(0o077)
 STATE.mkdir(parents=True,exist_ok=True,mode=0o700)
 if STATE.stat().st_uid != os.getuid() or STATE.stat().st_mode & 0o077: raise RuntimeError('state directory must be owned by current user and mode 0700')
 # Short socket path, unique to this state directory; enclosing dir private.
 runtime=Path('/tmp')/('android-dispenser-'+str(os.getuid())+'-'+hashlib.sha256(str(STATE).encode()).hexdigest()[:16])
 runtime.mkdir(mode=0o700,exist_ok=True)
 if runtime.is_symlink() or runtime.stat().st_uid != os.getuid() or runtime.stat().st_mode & 0o077: raise RuntimeError('unsafe runtime directory')
 return runtime

def send(sock,obj): sock.sendall((json.dumps(obj)+'\n').encode())
def receive(sock):
 data=bytearray()
 while not data.endswith(b'\n'):
  b=sock.recv(1)
  if not b: raise ConnectionError('dispenser connection closed')
  data.extend(b)
  if len(data)>65536: raise ValueError('dispenser message too large')
 return json.loads(data)

def qmp(path,command,args=None,timeout=10):
 with socket.socket(socket.AF_UNIX) as s:
  s.settimeout(timeout); s.connect(str(path)); receive(s)
  send(s,{'execute':'qmp_capabilities'})
  while 'return' not in receive(s): pass
  send(s,{'execute':command,'arguments':args or {}})
  while True:
   r=receive(s)
   if 'error' in r: raise RuntimeError(str(r['error']))
   if 'return' in r: return r['return']

def adb(c,port):
 return [str(Path(c['sdk'])/'platform-tools/adb'),'-s','emulator-'+str(port),'shell','-T']

def android(c,port,*command):
 return [c.get('android_cli','/usr/local/bin/android'),'--sdk='+c['sdk'],*command,'--device=emulator-'+str(port)]

def cli_result(command,timeout,cancel):
 result=bounded(command,timeout,cancel=cancel)
 # Android CLI can print an error while returning exit status zero.
 if result['exit_code']==0 and re.search(r'(?im)^\s*(?:error:|component check failed)',result['stderr']+'\n'+result['stdout']): result['exit_code']=1
 return result

def cli_app(c,port,name,args,cancel):
 apks=args.get('apks')
 if not isinstance(apks,list) or not apks or not all(isinstance(p,str) and os.path.isabs(p) and ',' not in p and '\0' not in p and Path(p).is_file() for p in apks): raise ValueError('apks must be existing absolute host file paths without commas')
 command=android(c,port,'install' if name=='install_app' else 'run')+['--apks='+','.join(apks)]
 if 'activity' in args:
  if name!='run_app' or not isinstance(args['activity'],str) or not args['activity'] or '\0' in args['activity']: raise ValueError('invalid activity')
  command.append('--activity='+args['activity'])
 return cli_result(command,300,cancel)

def screenshot(c,port,cancel):
 with tempfile.TemporaryDirectory(prefix='android-screen-',dir=STATE) as folder:
  path=Path(folder)/'screen.png'
  result=cli_result(android(c,port,'screen','capture')+['--output='+str(path)],60,cancel)
  if result['exit_code'] or result['timed_out']: raise RuntimeError('screenshot failed: '+result['stderr']+result['stdout'])
  with path.open('rb') as src: data=src.read(16*1024*1024+1)
  if len(data)>16*1024*1024 or not data.startswith(b'\x89PNG\r\n\x1a\n'): raise RuntimeError('invalid or oversized screenshot')
  return {'content':[{'type':'image','mimeType':'image/png','data':base64.b64encode(data).decode()}]}

def layout(c,port,cancel,timeout=60,flat=False,idle=False):
 with tempfile.TemporaryDirectory(prefix='android-layout-',dir=STATE) as folder:
  path=Path(folder)/'layout.json'
  result=cli_result(android(c,port,'layout')+['--full','--output='+str(path)]+(['--flat'] if flat else [])+(['--no-idle'] if flat and not idle else []),timeout,cancel)
  if result['exit_code'] or result['timed_out']: return result
  with path.open('rb') as src: data=src.read(1024*1024+1)
  if len(data)>1024*1024: raise RuntimeError('layout exceeds 1 MiB')
  result['stdout']=json.dumps(json.loads(data),separators=(',',':'))
  result['truncated']=False
  return result

def integer(args,key,default=None,lo=0,hi=100000):
 value=args.get(key,default)
 if type(value) is not int or not lo<=value<=hi: raise ValueError(f'{key} must be an integer from {lo} to {hi}')
 return value

class InteractionSession:
 def __init__(self,c,port,cancel):
  self.c=c; self.port=port; self.cancel=cancel; self.recording=None
 def __enter__(self): return self
 def __exit__(self,*_):
  if self.recording:
   with contextlib.suppress(Exception): self.finish_recording(discard=True)
 def run(self,argv,timeout=30):
  result=execute(self.c,self.port,{'argv':argv,'timeout_sec':timeout},self.cancel)
  if result['exit_code'] or result['timed_out']: raise RuntimeError(json.dumps(result))
  return result
 def elements(self,selector,timeout=60):
  fields={'text':'text','resource_id':'resource-id','description':'content-desc','class_name':'class'}
  if not isinstance(selector,dict) or not selector or any(k not in fields or not isinstance(v,str) or not v for k,v in selector.items()): raise ValueError('invalid selector')
  result=layout(self.c,self.port,self.cancel,timeout=timeout,flat=True)
  if result['exit_code'] or result['timed_out'] or result['truncated']: raise RuntimeError('layout failed: '+json.dumps(result))
  nodes=json.loads(result['stdout'])
  if not isinstance(nodes,list): raise RuntimeError('Android CLI returned an unexpected flat layout')
  matches=[]
  for node in nodes:
   if not isinstance(node,dict) or node.get('hidden') or node.get('off-screen'): continue
   if not all(node.get(fields[k])==v for k,v in selector.items()): continue
   b=re.fullmatch(r'\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]',node.get('bounds',''))
   if not b: continue
   left,top,right,bottom=map(int,b.groups())
   if right<=max(0,left) or bottom<=max(0,top): continue
   matches.append({**node,'center_x':(max(0,left)+right)//2,'center_y':(max(0,top)+bottom)//2})
  return matches
 def focused_editor(self):
  result=layout(self.c,self.port,self.cancel,timeout=15,flat=True,idle=True)
  if result['exit_code'] or result['timed_out']: raise RuntimeError('cannot inspect focused editor: '+json.dumps(result))
  nodes=json.loads(result['stdout'])
  if not isinstance(nodes,list) or not any(isinstance(n,dict) and 'FOCUSED' in n.get('state',[]) and 'EDITABLE' in n.get('interactions',[]) and not n.get('hidden') for n in nodes): raise ValueError('focus an editable text field before typing or clearing')
 def clear(self,checked=False):
  if not checked: self.focused_editor()
  self.run(['input','keycombination','KEYCODE_CTRL_LEFT','KEYCODE_A'])
  return self.run(['input','keyevent','KEYCODE_DEL'])
 def finish_recording(self,path=None,discard=False):
  if not self.recording: raise ValueError('no recording started in this lease')
  pid,guest=self.recording
  if not discard:
   if path is not None and (not isinstance(path,str) or not os.path.isabs(path) or '\0' in path): raise ValueError('local_path must be absolute')
   dest=Path(path) if path else STATE/'recordings'/(Path(guest).name)
   if not path: dest.parent.mkdir(mode=0o700,exist_ok=True)
   if dest.exists() or dest.is_symlink(): raise ValueError('recording destination already exists')
   if not dest.parent.is_dir(): raise ValueError('recording destination parent must exist')
  # SIGINT makes screenrecord finalize the MP4. Wait for exit (including zombies).
  script=f'kill -INT {pid} 2>/dev/null; for i in $(seq 1 50); do if ! kill -0 {pid} 2>/dev/null || grep -q "State:.*Z" /proc/{pid}/status 2>/dev/null; then exit 0; fi; sleep 0.1; done; exit 1'
  result=bounded(adb(self.c,self.port)+[shlex.join(['sh','-c',script])],10)
  if not discard and result['exit_code']: raise RuntimeError('recording did not finalize; retry stop_recording')
  if not discard:
   with tempfile.TemporaryDirectory(prefix='.android-recording-',dir=dest.parent) as folder:
    temp=Path(folder)/'capture.mp4'
    result=bounded(adb(self.c,self.port)[:-2]+['pull',guest,str(temp)],60,cancel=self.cancel)
    if result['exit_code'] or result['timed_out']: raise RuntimeError('recording export failed: '+json.dumps(result))
    with temp.open('rb') as src:
     if src.read(12)[4:8]!=b'ftyp': raise RuntimeError('recording is empty or invalid; retry after allowing capture to start')
     src.seek(0); digest=hashlib.sha256()
     for block in iter(lambda:src.read(1024*1024),b''): digest.update(block)
     digest=digest.hexdigest()
    temp.chmod(0o600); os.link(temp,dest)
   output={'local_path':str(dest),'bytes':dest.stat().st_size,'sha256':digest}
  bounded(adb(self.c,self.port)+[shlex.join(['rm','-f',guest,guest+'.log'])],10)
  self.recording=None
  return {} if discard else output
 def call(self,name,args):
  if self.cancel.is_set(): raise RuntimeError('client disconnected')
  if name in ('swipe','drag_and_drop','long_press','scroll'):
   duration=integer(args,'duration_ms',1000 if name=='long_press' else 500,1,10000)
   if name=='long_press':
    x=integer(args,'x'); y=integer(args,'y'); coords=[x,y,x,y]
   elif name=='scroll':
    direction=args.get('direction')
    if direction not in ('up','down','left','right'): raise ValueError('invalid scroll direction')
    bounds=args.get('bounds')
    if bounds is None:
     result=self.run(['dumpsys','input'])
     match=re.search(r'Viewport[^\n]*displayId=0,[^\n]*logicalFrame=\[0, 0, ([1-9]\d*), ([1-9]\d*)\][^\n]*isActive=\[1\]',result['stdout'])
     if not match: raise RuntimeError('cannot determine current display bounds; supply bounds')
     bounds=[0,0,*map(int,match.groups())]
    if not isinstance(bounds,list) or len(bounds)!=4 or any(type(v) is not int or v<0 for v in bounds): raise ValueError('bounds must contain four nonnegative integers')
    l,t,r,b=bounds
    if r-l<10 or b-t<10: raise ValueError('bounds must have positive width and height of at least 10 pixels')
    x=(l+r)//2; y=(t+b)//2; dx=(r-l)//4; dy=(b-t)//4
    coords={'down':[x,y+dy,x,y-dy],'up':[x,y-dy,x,y+dy],'right':[x+dx,y,x-dx,y],'left':[x-dx,y,x+dx,y]}[direction]
   else: coords=[integer(args,k) for k in ('x1','y1','x2','y2')]
   return self.run(['input','touchscreen','draganddrop' if name=='drag_and_drop' else 'swipe',*map(str,coords),str(duration)])
  if name=='type_text':
   value=args.get('text'); clear=args.get('clear',False)
   if not isinstance(value,str) or len(value)>4096 or any(ord(ch)<32 or ord(ch)>126 for ch in value): raise ValueError('text must be printable ASCII, at most 4096 characters')
   if type(clear) is not bool: raise ValueError('clear must be boolean')
   self.focused_editor()
   if clear: self.clear(checked=True)
   # Separate percent characters so Android never interprets a literal %s as space.
   for chunk in re.split('(%)',value):
    if chunk: self.run(['input','text',chunk.replace(' ','%s')])
   return {'typed_characters':len(value),'cleared':clear}
  if name=='keyboard':
   action=args.get('action')
   if action=='clear': return self.clear()
   if action=='submit': return self.run(['input','keyevent','KEYCODE_ENTER'])
   if action=='hide':
    status=self.run(['dumpsys','input_method'])['stdout']
    if re.search(r'mInputShown=true|isInputViewShown=true',status): return self.run(['input','keyevent','KEYCODE_BACK'])
    return {'hidden':True,'already_hidden':True}
   raise ValueError('invalid keyboard action')
  if name in ('find_elements','tap_element','wait_for_element'):
   selector=args.get('selector')
   if name=='wait_for_element':
    state=args.get('state','visible'); timeout=integer(args,'timeout_sec',30,1,120)
    if state not in ('visible','absent'): raise ValueError('invalid wait state')
    start=time.monotonic(); deadline=start+timeout
    while True:
     remaining=deadline-time.monotonic()
     if remaining<=0: raise TimeoutError(f'element did not become {state} within {timeout} seconds')
     matches=self.elements(selector,timeout=remaining)
     if bool(matches)==(state=='visible'): return {'state':state,'elements':matches,'elapsed_sec':round(time.monotonic()-start,3)}
     if self.cancel.wait(min(.3,max(0,deadline-time.monotonic()))): raise RuntimeError('client disconnected')
   matches=self.elements(selector)
   if name=='find_elements': return {'elements':matches,'count':len(matches)}
   index=integer(args,'index',0)
   if len(matches)>1 and 'index' not in args: raise ValueError(f'{len(matches)} elements matched; refine selector or supply index')
   if index>=len(matches): raise ValueError('no element at the requested index')
   node=matches[index]; self.run(['input','tap',str(node['center_x']),str(node['center_y'])]); return {'element':node}
  if name=='rotate':
   orientation=args.get('orientation'); modes={'portrait':0,'landscape':1,'reverse_portrait':2,'reverse_landscape':3}
   if orientation!='auto' and orientation not in modes: raise ValueError('invalid orientation')
   if self.recording: raise ValueError('stop recording before rotating')
   return self.run(['wm','user-rotation',*(['free'] if orientation=='auto' else ['lock',str(modes[orientation])])])
  if name=='app_lifecycle':
   action=args.get('action')
   if action not in ('background','resume','stop','relaunch'): raise ValueError('invalid lifecycle action')
   if action=='background': return self.run(['input','keyevent','KEYCODE_HOME'])
   package=args.get('package')
   if not isinstance(package,str) or not re.fullmatch(r'[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+)+',package): raise ValueError('valid package required')
   exists=self.run(['pm','path',package])
   if not exists['stdout'].startswith('package:'): raise ValueError('package is not installed')
   if action=='stop': return self.run(['am','force-stop',package])
   result=self.run(['cmd','package','resolve-activity','--brief','-a','android.intent.action.MAIN','-c','android.intent.category.LAUNCHER',package])
   component=result['stdout'].strip().splitlines()[-1]
   if not re.fullmatch(r'[A-Za-z0-9_.$]+/[A-Za-z0-9_.$]+',component): raise RuntimeError('no launcher activity found')
   if action=='relaunch': self.run(['am','force-stop',package])
   result=self.run(['am','start','-W','-a','android.intent.action.MAIN','-c','android.intent.category.LAUNCHER','-n',component])
   if re.search(r'(?im)^Error',result['stdout']+result['stderr']): raise RuntimeError(json.dumps(result))
   return result
  if name=='start_recording':
   if self.recording: raise ValueError('a recording already exists; stop/export it first')
   duration=integer(args,'max_duration_sec',180,1,180)
   guest='/data/local/tmp/dispenser-recording-'+uuid.uuid4().hex+'.mp4'
   script=shlex.join(['nohup','screenrecord','--time-limit',str(duration),guest])+' </dev/null >'+shlex.quote(guest+'.log')+' 2>&1 & echo $!'
   result=self.run(['sh','-c',script]); pid=result['stdout'].strip()
   if not pid.isdigit(): raise RuntimeError('screenrecord did not return a process id')
   self.recording=(int(pid),guest)
   self.run(['sh','-c',f'sleep 0.3; kill -0 {pid}'])
   return {'recording':True,'max_duration_sec':duration,'guest_path':guest}
  if name=='stop_recording': return self.finish_recording(args.get('local_path'))
  raise ValueError('unknown interaction tool')

def alive(r):
 try:
  raw=Path('/proc/'+str(r['pid'])+'/cmdline').read_bytes().split(b'\0')
  return str(Path(r['disk']).parent).encode() in raw and (r['id'].encode() in raw or ('android-dispenser-'+r['id']).encode() in raw)
 except (KeyError,OSError): return False

def atomic(path,obj):
 tmp=path.with_suffix('.tmp'); tmp.write_text(json.dumps(obj,indent=2)+'\n'); tmp.replace(path)

def base_api_level(c):
 def properties(path):
  values={}
  for line in path.read_text().splitlines():
   key,sep,value=line.partition('=')
   if sep and not key.lstrip().startswith(('#','!')): values[key.strip()]=value.strip()
  return values
 template=Path(c['base'])/'config.ini'
 try:
  image=properties(template).get('image.sysdir.1')
  if not image: raise ValueError('image.sysdir.1 is missing')
  folder=Path(image)
  if not folder.is_absolute(): folder=Path(c['sdk'])/folder
  level=properties(folder/'source.properties').get('AndroidVersion.ApiLevel','')
  if not level.isdecimal() or int(level)<1: raise ValueError('AndroidVersion.ApiLevel must be a positive integer')
  return int(level)
 except (OSError,ValueError) as e:
  raise RuntimeError('Cannot read Android version for base '+str(template)+': '+str(e)) from e

class Dispenser:
 def __init__(self,c,runtime):
  self.c=c; self.runtime=runtime; self.lock=threading.RLock(); self.records={}; self.leases={}; self.activity={}; self.busy=set(); self.stopping=False; self.idle_timer=None; self.disconnected={}
  (STATE/'instances').mkdir(exist_ok=True)
  self.api_level=base_api_level(c)
  self.processes={}
  # Records exist only to identify and clean up owned processes after a crash.
  # Old retained disks and orphaned guests are never resumed.
  for folder in (STATE/'instances').iterdir():
   if not folder.is_dir() or len(folder.name)!=32 or any(ch not in '0123456789abcdef' for ch in folder.name): continue
   r={'id':folder.name,'disk':str(folder/'userdata-qemu.img'),'qmp':str(runtime/(folder.name[:12]+'.qmp'))}
   record=folder/'record.json'
   if record.exists():
    saved=json.loads(record.read_text())
    if 'pid' in saved: r['pid']=saved['pid']
   self.records[r['id']]=r
   self.destroy(r)
