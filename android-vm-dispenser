  log('VM ready (instance '+r['id']+').')
  c=config()
  # The running dispenser owns viewer policy; clients must honor startup overrides.
  c['auto_view']=r.get('auto_view',c['auto_view'])
  auto_view(r['id'],c)
  if c['auto_view']:
   viewer_thread=threading.Thread(target=keep_viewer,args=(r['id'],viewer_stop,cancel),daemon=True)
   viewer_thread.start()
  yield c,r['port'],s
