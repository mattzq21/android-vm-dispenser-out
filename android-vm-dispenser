 if min(visible_width,visible_height)<100: raise RuntimeError('desktop work area is too small')
 frame=cardinals(['-id',hex(window)],'_GTK_FRAME_EXTENTS')
 if len(frame)!=4:
  frame=cardinals(['-id',hex(window)],'_NET_FRAME_EXTENTS')
  frame=[-v for v in frame] if len(frame)==4 else [0,0,0,0]
