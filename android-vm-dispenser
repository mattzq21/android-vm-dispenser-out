 try:
  result=bounded(adb(c,port)[:-2]+['push',local,temporary],130,cancel=cancel)
  if result['exit_code']!=0: raise RuntimeError('upload failed: '+result['stderr'])
  digest=execute(c,port,{'argv':['sha256sum',temporary]},cancel=cancel)
  if digest['exit_code'] or digest['stdout'].split()[0]!=h.hexdigest(): raise RuntimeError('uploaded file checksum mismatch')
  command=shlex.join(['chmod','0755' if executable else '0644',temporary])+' && '+shlex.join(['mv','-f',temporary,guest])
  result=execute(c,port,{'argv':['sh','-c',command]},cancel=cancel)
