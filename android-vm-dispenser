def launch_viewer(key):
 if len(key)!=32 or any(ch not in '0123456789abcdef' for ch in key): raise ValueError('invalid viewer instance ID')
 record=STATE/'instances'/key/'record.json'
 r=json.loads(record.read_text())
 if r.get('id')!=key or not alive(r): raise RuntimeError('instance is not running')
 c=config(); runtime=setup(); serial='emulator-'+str(c['port_start']+2*r['slot'])
 executable=c.get('viewer',shutil.which('scrcpy'))
 if not executable: raise RuntimeError('scrcpy is not installed')
 with open(runtime/(key+'.view.lock'),'a') as lock:
  fcntl.flock(lock,fcntl.LOCK_EX)
  if not record.is_file() or not alive(r): raise RuntimeError('instance stopped')
  marker=runtime/(key+'.viewer.json')
  try:
   saved=json.loads(marker.read_text())
   command=Path('/proc/'+str(saved['pid'])+'/cmdline').read_bytes().split(b'\0')
   if serial.encode() in command and ('Android '+key[:12]).encode() in command and any(Path(os.fsdecode(x)).name=='scrcpy' for x in command if x):
    if b'--no-control' not in command: return serial
    os.kill(saved['pid'],signal.SIGTERM)
    deadline=time.monotonic()+3
    while True:
     try: remaining=Path('/proc/'+str(saved['pid'])+'/cmdline').read_bytes()
     except FileNotFoundError: break
     if not remaining: break
     if time.monotonic()>=deadline: raise RuntimeError('old view-only viewer did not exit')
     time.sleep(.05)
  except (OSError,ValueError,KeyError): pass
  if not (os.environ.get('DISPLAY') or os.environ.get('WAYLAND_DISPLAY')): raise RuntimeError('no graphical session')
  env=dict(os.environ,ADB=str(Path(c['sdk'])/'platform-tools/adb'))
  env['SDL_WINDOW_ACTIVATE_WHEN_SHOWN']='0'
  env['SDL_WINDOW_ACTIVATE_WHEN_RAISED']='0'
  if env.get('DISPLAY'): env['SDL_VIDEO_DRIVER']='x11'
  with open(STATE/'viewer.log','ab') as out:
   proc=subprocess.Popen([executable,'--serial',serial,'--no-audio','--no-clipboard-autosync','--no-window-aspect-ratio-lock','--window-borderless','--window-title','Android '+key[:12],'--window-width','360','--window-height','640'],stdin=subprocess.DEVNULL,stdout=out,stderr=out,start_new_session=True,env=env)
  atomic(marker,{'pid':proc.pid,'url':serial})
  try: code=proc.wait(timeout=.2)
  except subprocess.TimeoutExpired: pass
  else: raise RuntimeError('scrcpy exited: '+str(code))
  with open(STATE/'viewer.log','ab') as out:
   watcher="import runpy,sys; b=runpy.run_path(sys.argv[1],run_name='viewer_watcher'); b['place_viewer'](sys.argv[2],int(sys.argv[3]),b['setup']())"
   subprocess.Popen([sys.executable,'-c',watcher,str(Path(__file__).resolve()),key,str(proc.pid)],stdin=subprocess.DEVNULL,stdout=out,stderr=out,start_new_session=True)
 return serial


def main():
 parser=argparse.ArgumentParser(description=__doc__)
 sub=parser.add_subparsers(dest='command',required=True)
 for command in ('mcp','upload'):
  p=sub.add_parser(command)
  if command=='upload': p.add_argument('--executable',action='store_true'); p.add_argument('local_path'); p.add_argument('guest_path')
 for command in ('serve','stop','restart'): sub.add_parser(command)
 p=sub.add_parser('start'); p.add_argument('--background',action='store_true',help='start the dispenser with automatic viewers disabled')
 args=parser.parse_args()
 # EOF, signal termination and ordinary errors all close the lease socket.
 def interrupted(signum,frame): raise KeyboardInterrupt()
 signal.signal(signal.SIGTERM,interrupted)
 try:
  runtime=setup()
  if args.command=='serve':
   c=config()
   if os.environ.get('ANDROID_VM_DISPENSER_BACKGROUND')=='1': c['auto_view']=False
   with open(runtime/'daemon.lock','a') as lock:
    fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB); Dispenser(c,runtime).serve()
   return
  if args.command in ('start','stop','restart'):
   req={'op':'status' if args.command in ('start','restart') else 'shutdown'}
   background=args.command=='start' and args.background
   with connect(runtime,background=background) as sock: send(sock,req); r=receive(sock)
   if not r.get('ok'): raise RuntimeError(r.get('error'))
   if background and r.get('config',{}).get('auto_view') is not False:
    raise RuntimeError('dispenser is already running without confirmed background mode; run stop after active leases finish, then start --background')
   if args.command=='restart':
    background=r.get('config',{}).get('auto_view',config()['auto_view']) is False
    with connect(runtime) as sock: send(sock,{'op':'shutdown'}); r=receive(sock)
    if not r.get('ok'): raise RuntimeError(r.get('error'))
   if args.command in ('stop','restart'):
    # The reply acknowledges the request; the daemon still owns its listener
    # until cleanup finishes. Do not let a following command reconnect to it.
    with open(runtime/'start.lock','a') as start_lock:
     fcntl.flock(start_lock,fcntl.LOCK_EX)
     with open(runtime/'daemon.lock','a') as daemon_lock:
      fcntl.flock(daemon_lock,fcntl.LOCK_EX)
   if args.command=='restart':
    with connect(runtime,background=background) as sock: send(sock,{'op':'status'}); r=receive(sock)
    if not r.get('ok'): raise RuntimeError(r.get('error'))
   print(json.dumps(r,indent=2)); return
  if args.command=='mcp': mcp()
  else:
   with lease() as (c,port,control):
    control.sendall(b'B')
    result=upload(c,port,vars(args))
    print(json.dumps(result,indent=2))
    if result.get('exit_code',0): sys.exit(1)
 except KeyboardInterrupt: sys.exit(130)
 except Exception as e: log('android-vm-dispenser: '+str(e)); sys.exit(1)

if __name__=='__main__': main()
