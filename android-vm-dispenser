def viewer_slots(window):
 def cardinals(args,name):
  result=subprocess.run(['xprop',*args,name],capture_output=True,text=True,check=True,timeout=2)
  match=re.search(re.escape(name)+r'\(CARDINAL\) = ([\d, ]+)',result.stdout)
  return [int(v) for v in match[1].split(',')] if match else []
